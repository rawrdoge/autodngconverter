# RawImport Pipeline — local .env (NOT committed; gitignored)
# Copy to ".env" and fill in your LIVE MariaDB credentials.
# The binary reads this file via loadDotEnv() when present.
# Real environment variables always take precedence over this file.

# --- MariaDB connection ---
DB_DRIVER=mariadb
DB_HOST=your-mariadb-host
DB_PORT=3306
DB_USER=rawimport
DB_PASSWORD=change-me
DB_NAME=rawimport
DB_ROOT_PASSWORD=change-me

# --- Host volume mounts (override defaults for your NAS) ---
WATCH_HOST=/mnt/nas/photos/watch
OUTPUT_HOST=/mnt/nas/photos/output
ARCHIVE_HOST=/mnt/nas/photos/archive

# --- Converter engine ---
CONVERTER_ENGINE=dnglab
DNGLAB_BIN=dnglab

# --- EXIF / thumbnail extraction ---
EXIFTOOL_BIN=exiftool

# --- Pipeline paths (container-internal) ---
WATCH_DIR=/watch
OUTPUT_DIR=/output
ARCHIVE_DIR=/archive

# --- Folder / naming ---
FOLDER_SCHEMA=%Y/%m
FILE_PATTERN=IMG_{seq}

# --- Default conversion settings ---
DEF_COMPRESSION=lossless
DEF_DNG_VERSION=1.4
DEF_PREVIEW_MEDIUM=1024x1024
DEF_PREVIEW_FULL=4000x3000
DEF_JPEG_QUALITY=92
DEF_LINEAR=false

# --- Sidecar thumbnail JPEG ---
GEN_THUMB_JPEG=false

# --- Misc ---
POLL_INTERVAL=10
PORT=8080
LOG_LEVEL=info

# --- Preview re-embed notify ---
API_TOKEN=
RAWIMPORT_API_URL=http://localhost:8080