# --- MariaDB connection (external instance required) ---
DB_DRIVER=mariadb
DB_HOST=your-mariadb-host
DB_PORT=3306
DB_USER=rawimport
DB_PASSWORD=change-me
DB_NAME=rawimport
DB_SSLMODE=disable

# --- Container-internal paths (app config) ---
WATCH_DIR=/watch
OUTPUT_DIR=/output
ARCHIVE_DIR=/archive

# --- Engine selection ---
CONVERTER_ENGINE=dnglab
# CONVERTER_ENGINE_BIN=          # Optional: explicit binary path override
APPDATA_DIR=/appdata

# --- Folder / naming ---
FOLDER_SCHEMA=%Y/%m
FILE_PATTERN=IMG_{seq}

# --- Default conversion settings ---
DEF_COMPRESSION=lossless
DEF_DNG_VERSION=1.4
DEF_PREVIEW_MEDIUM=1024x1024
DEF_PREVIEW_FULL=4000x3000
DEF_JPEG_QUALITY=92
DEF_LINEAR=false

# --- Sidecar thumbnail JPEG ---
GEN_THUMB_JPEG=false

# --- Misc ---
POLL_INTERVAL=10
PORT=8080
LOG_LEVEL=info

# --- Preview re-embed notify ---
API_TOKEN=
RAWIMPORT_API_URL=http://localhost:8080