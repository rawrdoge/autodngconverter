# --- MariaDB connection (external instance required) ---
RAWIMPORT_DB_DRIVER=mariadb
RAWIMPORT_DB_HOST=your-mariadb-host
RAWIMPORT_DB_PORT=3306
RAWIMPORT_DB_USER=rawimport
RAWIMPORT_DB_PASSWORD=change-me
RAWIMPORT_DB_NAME=rawimport
RAWIMPORT_DB_SSLMODE=disable

# --- Container-internal paths (app config) ---
RAWIMPORT_INPUT_DIR=/watch
RAWIMPORT_OUTPUT_DIR=/output
RAWIMPORT_ARCHIVE_DIR=/archive

# --- Engine selection ---
RAWIMPORT_CONVERTER_ENGINE=dnglab
# RAWIMPORT_CONVERTER_ENGINE_BIN=          # Optional: explicit binary path override
RAWIMPORT_APPDATA_DIR=/appdata

# --- Folder / naming ---
RAWIMPORT_FOLDER_SCHEMA=%Y/%m
RAWIMPORT_FILE_PATTERN=IMG_{seq}

# --- Default conversion settings ---
RAWIMPORT_DEF_COMPRESSION=lossless
RAWIMPORT_DEF_DNG_VERSION=1.4
RAWIMPORT_DEF_PREVIEW_MEDIUM=1024x1024
RAWIMPORT_DEF_PREVIEW_FULL=4000x3000
RAWIMPORT_DEF_JPEG_QUALITY=92
RAWIMPORT_DEF_LINEAR=false

# --- Sidecar thumbnail JPEG ---
RAWIMPORT_GEN_THUMB_JPEG=false

# --- Misc ---
RAWIMPORT_POLL_INTERVAL=10

# --- Performance & reliability (PRD v2.1.0 §9.2) ---
RAWIMPORT_MAX_CONVERTER_WORKERS=0        # 0 = auto (hardware_concurrency, capped at 8); forced to 1 for adobedng
RAWIMPORT_EXIFTOOL_DAEMON=true           # persistent exiftool subprocess for EXIF extraction
RAWIMPORT_DEAD_LETTER_MAX_RETRIES=3      # consecutive failures before move to /archive/failed/
RAWIMPORT_FAST_FINGERPRINT=true          # size+mtime+FNV-1a(first 4KB) gate before full SHA-256
RAWIMPORT_PORT=8080
RAWIMPORT_LOG_LEVEL=info

# --- Preview re-embed notify ---
RAWIMPORT_API_TOKEN=
RAWIMPORT_API_URL=http://localhost:8080