# --- MariaDB connection (external instance required) ---
DB_DRIVER=mariadb
DB_HOST=your-mariadb-host
DB_PORT=3306
DB_USER=rawimport
DB_PASSWORD=change-me
DB_NAME=rawimport
DB_SSLMODE=disable

# --- Container-internal paths (app config) ---
WATCH_DIR=/watch
OUTPUT_DIR=/output
ARCHIVE_DIR=/archive

# --- Engine selection ---
CONVERTER_ENGINE=dnglab
# CONVERTER_ENGINE_BIN=          # Optional: explicit binary path override
APPDATA_DIR=/appdata

# --- Folder / naming ---
FOLDER_SCHEMA=%Y/%m
FILE_PATTERN=IMG_{seq}

# --- Default conversion settings ---
DEF_COMPRESSION=lossless
DEF_DNG_VERSION=1.4
DEF_PREVIEW_MEDIUM=1024x1024
DEF_PREVIEW_FULL=4000x3000
DEF_JPEG_QUALITY=92
DEF_LINEAR=false

# --- Sidecar thumbnail JPEG ---
GEN_THUMB_JPEG=false

# --- Misc ---
POLL_INTERVAL=10

# --- Performance & reliability (PRD v2.1.0 §9.2) ---
MAX_CONVERTER_WORKERS=0        # 0 = auto (hardware_concurrency, capped at 8); forced to 1 for adobedng
EXIFTOOL_DAEMON=true           # persistent exiftool subprocess for EXIF extraction
DEAD_LETTER_MAX_RETRIES=3      # consecutive failures before move to /archive/failed/
FAST_FINGERPRINT=true          # size+mtime+FNV-1a(first 4KB) gate before full SHA-256
PORT=8080
LOG_LEVEL=info

# --- Preview re-embed notify ---
API_TOKEN=
RAWIMPORT_API_URL=http://localhost:8080