# --- RawImport Portable v2.1.0 ---
# Rename this file to ".env" to use it. All values are optional;
# defaults are relative to the folder containing rawimport.exe.

# RAWIMPORT_HOME=C:\path\to\rawimport     # override the portable root

# --- Folder layout (defaults shown) ---
# WATCH_DIR=<root>/watch
# OUTPUT_DIR=<root>/output
# ARCHIVE_DIR=<root>/archive
# DB_NAME=<root>/data/rawimport.db        # single local SQLite file

# --- External tools (bundled in tools/; overrides optional) ---
# CONVERTER_ENGINE_BIN=<root>/tools/dnglab.exe
# EXIFTOOL_BIN=<root>/tools/exiftool.exe

# --- Folder / naming ---
FOLDER_SCHEMA=%Y/%m
FILE_PATTERN=IMG_{seq}

# --- Default conversion settings ---
DEF_COMPRESSION=lossless                  # lossless | uncompressed
GEN_THUMB_JPEG=false                      # also write a sidecar thumbnail JPEG

# --- Misc ---
POLL_INTERVAL=10                          # seconds between watch scans
HTTP_PORT=8080
LOG_LEVEL=info

# --- Performance & reliability ---
MAX_CONVERTER_WORKERS=0                   # 0 = auto (hardware threads, capped at 8)
DEAD_LETTER_MAX_RETRIES=3                 # failures before move to archive/failed/
FAST_FINGERPRINT=true                     # quick duplicate gate before full SHA-256
